      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "One payer per batch; self-payments allowed\nFunds >= gross new outgoing, including self-payments\nNo funding from credits inside the same batch\nON: key = payer + payee + exact description\nSame amount \u2192 skip; different amount \u2192 reject whole batch\nOFF: insert all valid entries; funds cover all entries",
      "originalText": "One payer per batch; self-payments allowed\nFunds >= gross new outgoing, including self-payments\nNo funding from credits inside the same batch\nON: key = payer + payee + exact description\nSame amount \u2192 skip; different amount \u2192 reject whole batch\nOFF: insert all valid entries; funds cover all entries",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 18,
      "containerId": null,
